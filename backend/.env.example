# =============================================================================
# Backend / server environment. Copy to backend/.env and fill in real values.
#
# backend/.env is git-ignored. Never commit a file containing real credentials.
# On Vercel these are set as Project Settings > Environment Variables instead of
# shipping a file at all.
#
# NONE of the variables below belong in a VITE_ prefixed variable. Vite inlines
# every VITE_* value into the JavaScript bundle, so a secret placed there is
# readable by anyone who opens the site. The only frontend variables the app
# reads are VITE_API_URL and VITE_API_TIMEOUT_MS, both listed at the bottom.
# =============================================================================

# --- Database ---------------------------------------------------------------
# The database name MUST be in the path. An omitted name makes the driver fall
# back to "test", which is how this project ended up writing to a database
# called test.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/nextup?retryWrites=true&w=majority

# Optional connection tuning. The defaults in backend/config/db.js are tuned for
# Atlas free/shared tiers and serverless; only set these if you have a reason.
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_CONNECT_TIMEOUT_MS=10000
# MONGO_SOCKET_TIMEOUT_MS=45000
# MONGO_BUFFER_TIMEOUT_MS=10000
# MONGO_MAX_POOL_SIZE=10
# MONGO_MAX_IDLE_TIME_MS=30000
# MONGO_WAIT_QUEUE_TIMEOUT_MS=10000

# --- Authentication ---------------------------------------------------------
# Long random string. Rotating it invalidates every issued token, so all users
# are signed out once. Use at least 32 characters.
JWT_SECRET=replace_with_a_long_random_string

# --- Server -----------------------------------------------------------------
# Only used when running `npm run dev` locally. Vercel assigns its own port.
PORT=5000

# Comma-separated allowed browser origins, e.g.
# https://nextup.vercel.app,https://www.example.com
# Leave empty to allow any origin (the default, and what a single-origin
# deployment needs anyway).
CORS_ORIGINS=

# Rate limit per IP for /api. The default is deliberately generous: the
# notification bell polls every 30 seconds and refetches on every tab focus, so
# a tight limit makes an ordinary session look like a dead backend.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Maximum upload size in MB. Vercel rejects request bodies over 4.5 MB before
# the function runs, so this must stay at 4 or below on Vercel.
MAX_UPLOAD_MB=4

# --- Admin email recipients -------------------------------------------------
# Administrators who receive admin-only email. Every address listed here is put
# in the To header of ONE message, so one event produces one email operation no
# matter how many administrators there are.
ADMIN_EMAIL_1=admin.one@example.com
ADMIN_EMAIL_2=admin.two@example.com
# Extra recipients, comma separated. Add a third or fourth administrator here
# rather than adding more numbered variables. ADMIN_EMAIL_3 also works - every
# ADMIN_EMAIL_<n> in the environment is collected.
# ADMIN_EMAILS=third.admin@example.com

# --- Outbound email ---------------------------------------------------------
# Never put real credentials in this file: copy it to .env and fill it in.
# Use an APP PASSWORD, not your normal account password.
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your_app_password_here
SMTP_FROM=you@example.com

# Absolute base URL of the deployed frontend, with no trailing slash. Used for
# the "Login" button in the approval email and the "Review Registration" button
# in the admin notification email. Must be the real deployed origin in
# production; a localhost value is ignored there and the links are omitted.
FRONTEND_URL=https://your-app.example.com

# Consecutive delivery failures after which an address stops being emailed.
# Keeps a dead or undeliverable address from being retried on every event.
EMAIL_MAX_FAILURES=3

# Comma-separated addresses that must never be emailed again. Put an address
# here as soon as you know delivery to it fails, so it leaves rotation on the
# very next event rather than after another bounced message. Automatic sends
# skip these addresses; only an explicit admin resend will try them again.
EMAIL_SUPPRESSED_ADDRESSES=

# --- File uploads (Cloudinary) ---------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cloudflare R2 (optional alternative storage) ---------------------------
# Only needed if R2 is used in place of Cloudinary.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=


# =============================================================================
# Frontend variables (optional)
# =============================================================================
# These live in frontend/.env.local for local work, and in the Vercel project
# settings for production. They are the ONLY variables that reach the browser,
# and none of them may hold a secret.
#
# VITE_API_URL - leave unset in production. The frontend then calls /api on its
#   own origin and Vercel routes it to the serverless function, which avoids a
#   cross-origin request entirely. Set it only if the API is on another origin.
# VITE_API_URL=https://api.example.com
#
# VITE_API_TIMEOUT_MS - how long to wait for an answer before treating the
#   request as failed. Default 20000.
# VITE_API_TIMEOUT_MS=20000
