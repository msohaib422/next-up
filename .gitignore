# Dependencies
node_modules/

# Build output. Regenerated by `npm run build`; never committed, so a stale
# bundle can never be served or shipped to Vercel.
frontend/dist/
dist/
.vercel/

# Local database backups written by backend/scripts/backup-accounts.mjs.
# They contain password hashes, so they are as sensitive as the database.
.backups/

# Secrets. Only .env.example is committed.
.env
.env.local
.env.development
.env.production
.env.*.local
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
